# Comma-separated OpenRouter key pool (at least 2). Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=sk-or-v1-your-key-1,sk-or-v1-your-key-2
# SQLite file; /data is the Docker named volume
DATABASE_URL=sqlite:////data/app.db
# Comma-separated CORS origins (add your deployed frontend URL)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# true enables the X-Simulate-Failure test hook
ENABLE_FAILURE_SIMULATION=true
# LiteLLM model name, "openrouter/" prefix + OpenRouter model id
LLM_MODEL=openrouter/google/gemini-3.1-flash-lite
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
LLM_TIMEOUT_SECONDS=30
# Frontend build-time API URL (browser-visible backend URL)
VITE_API_URL=http://localhost:8000
